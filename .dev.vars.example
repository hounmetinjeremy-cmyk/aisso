# Copiez ce fichier en .dev.vars pour le développement local avec 'wrangler dev' / 'remix vite:dev'.
# Remplace bindings.sh (obsolète, ne servait qu'à 'wrangler pages dev').
# .dev.vars est lu nativement par Wrangler, aucune commande à lancer.

ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
HuggingFace_API_KEY=
HYPERBOLIC_API_KEY=
OPEN_ROUTER_API_KEY=
OLLAMA_API_BASE_URL=
OPENAI_LIKE_API_BASE_URL=
OPENAI_LIKE_API_KEY=
TOGETHER_API_BASE_URL=
HYPERBOLIC_API_BASE_URL=
LMSTUDIO_API_BASE_URL=
AWS_BEDROCK_CONFIG=
VITE_GITHUB_ACCESS_TOKEN=
VITE_GITHUB_TOKEN_TYPE=
VITE_GITLAB_ACCESS_TOKEN=
VITE_GITLAB_URL=
VITE_GITLAB_TOKEN_TYPE=
VITE_VERCEL_ACCESS_TOKEN=
VITE_NETLIFY_ACCESS_TOKEN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ACCESS_TOKEN=
NODE_ENV=
PORT=
VITE_LOG_LEVEL=
DEFAULT_NUM_CTX=

# Clé service_role Supabase (Project Settings > API) — contourne les policies
# RLS, sert côté serveur uniquement pour les snapshots vérifiés et les
# connexions GitHub/Vercel des utilisateurs. Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Domaine réel du déploiement (ex: https://aisso.hounmetinjeremy.workers.dev),
# utilisé pour construire les URLs de redirection OAuth.
APP_BASE_URL=

# App OAuth GitHub (github.com/settings/developers > New OAuth App).
# Callback URL à déclarer : ${APP_BASE_URL}/api/connect/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Intégration Vercel (vercel.com/dashboard/integrations/console).
# Callback URL à déclarer : ${APP_BASE_URL}/api/connect/vercel/callback
# VERCEL_INTEGRATION_SLUG = le "URL Slug" choisi lors de la création de
# l'intégration (vercel.com/integrations/<slug>) : l'autorisation démarre
# sur vercel.com/integrations/<slug>/new, propre à chaque intégration.
VERCEL_OAUTH_CLIENT_ID=
VERCEL_OAUTH_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
